# Environment for docker compose (repository root).
#
#   cp .env.example .env    # then fill in DEEPSEEK_API_KEY
#   docker compose up --build
#
# Values here are interpolated by compose into the api service. The API also
# reads project/.env if you keep one (that file configures the Gradio app);
# variables set in this file win.

# Required for real answers (the DeepSeek chat model).
DEEPSEEK_API_KEY=

# HuggingFace endpoint for model downloads. huggingface.co is unreachable on
# some networks (notably this project's WSL2 dev box) — hf-mirror.com works.
HF_ENDPOINT=https://hf-mirror.com

# Host ports.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# PostgreSQL credentials used by both the postgres service and DATABASE_URL.
POSTGRES_USER=reflect
POSTGRES_PASSWORD=reflect
POSTGRES_DB=reflect_rag

# Cache TTLs (seconds).
ANSWER_CACHE_TTL=3600
EMBEDDING_CACHE_TTL=604800

# Browser origins allowed to call the API.
CORS_ORIGINS=*
