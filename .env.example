# Environment for docker compose (repository root).
#
#   cp .env.example .env    # then fill in DEEPSEEK_API_KEY
#   docker compose up --build
#
# Values here are interpolated by compose into the api service. The API also
# reads project/.env if you keep one (that file configures the Gradio app);
# variables set in this file win.

# Required for real answers (the DeepSeek chat model).
DEEPSEEK_API_KEY=

# HuggingFace endpoint for model downloads. huggingface.co is unreachable on
# some networks (notably this project's WSL2 dev box) — hf-mirror.com works.
HF_ENDPOINT=https://hf-mirror.com

# Host ports.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# PostgreSQL credentials used by both the postgres service and DATABASE_URL.
POSTGRES_USER=reflect
POSTGRES_PASSWORD=reflect
POSTGRES_DB=reflect_rag

# Cache TTLs (seconds). The jitter (0..300s) is added per answer so entries
# written in the same burst do not expire together.
ANSWER_CACHE_TTL=3600
ANSWER_CACHE_TTL_JITTER=300
EMBEDDING_CACHE_TTL=604800

# LangGraph checkpoints: postgres persists conversation state across restarts.
CHECKPOINT_BACKEND=postgres

# Per-IP rate limit on POST /api/v1/chat.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUST_PROXY=false

# LLM retry/backoff (tenacity) and the answer returned when retries run out.
LLM_RETRY_ENABLED=true
LLM_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_WAIT=1
LLM_RETRY_MAX_WAIT=20
LLM_RETRY_JITTER=2

# Browser origins allowed to call the API.
CORS_ORIGINS=*

# Async document ingestion worker (compose `worker` service).
INGEST_MAX_ATTEMPTS=3
INGEST_BACKOFF_SECONDS=1
INGEST_STALE_SECONDS=600
