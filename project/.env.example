# Langfuse Observability (optional)
# Set LANGFUSE_ENABLED=true and provide your API keys to enable tracing.
# Get your keys from https://cloud.langfuse.com or your self-hosted instance.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# --- REST API (project/api) -------------------------------------------------
# Everything below is optional: the defaults target a local install
# (PostgreSQL and Redis on localhost, embedded local-mode Qdrant).
# docker compose passes its own values to the container; see docker-compose.yml.

# PostgreSQL (conversations / messages / documents). Applied by `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://reflect:reflect@localhost:5432/reflect_rag

# LangGraph checkpoints: postgres persists agent state (conversation memory,
# pending clarification interrupts) across restarts; memory is dev-only.
CHECKPOINT_BACKEND=postgres

# Redis cache: high-frequency answers (TTL 1h) and dense embeddings.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
ANSWER_CACHE_TTL=3600
# 0..N seconds of random jitter added per answer (cache-avalanche avoidance).
ANSWER_CACHE_TTL_JITTER=300
EMBEDDING_CACHE_TTL=604800

# Per-IP rate limit on POST /api/v1/chat (Redis INCR sliding window).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Split the window into N buckets and sum the last N (1 = fixed window).
RATE_LIMIT_SUBWINDOWS=10
# Only enable behind a trusted reverse proxy (X-Forwarded-For is spoofable).
RATE_LIMIT_TRUST_PROXY=false

# LLM resilience: exponential backoff + fallback answer when retries run out.
LLM_RETRY_ENABLED=true
LLM_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_WAIT=1
LLM_RETRY_MAX_WAIT=20
LLM_RETRY_JITTER=2
# LLM_FALLBACK_MESSAGE=抱歉，模型服务暂时不可用，请稍后再试。

# Qdrant server. Leave empty to use the embedded database in qdrant_db/
# (one process at a time: local mode takes an exclusive file lock).
# QDRANT_URL=http://localhost:6333

# CORS for browser clients ("*" by default; list origins to allow credentials).
CORS_ORIGINS=*

# Startup: false keeps /docs and /health answerable while the models warm up.
RAG_EAGER_INIT=false
RAG_READY_TIMEOUT=300

# Uploads (POST /api/v1/documents) and their size limit.
# UPLOAD_DIR=/absolute/path/to/uploads
MAX_UPLOAD_MB=50

# --- Async document ingestion (Redis List queue, worker.py) -----------------
# POST /api/v1/documents only enqueues; run `python worker.py` to consume.
INGEST_MAX_ATTEMPTS=3
INGEST_BACKOFF_SECONDS=1
INGEST_STALE_SECONDS=600
INGEST_POLL_TIMEOUT=5
INGEST_QUEUE_KEY=doc:ingest:queue
INGEST_PROCESSING_KEY=doc:ingest:processing
